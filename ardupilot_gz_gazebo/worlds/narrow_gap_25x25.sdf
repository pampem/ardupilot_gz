          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <static>true</static>
      <self_collide>false</self_collide>
    </model>

    <!-- Left barrier (8m width, positioned to leave 2m gap in center) -->
    <model name='barrier_left'>
      <pose>-5 0 2.5 0 0 0</pose>
      <link name='barrier_link'>
        <inertial>
          <inertia>
            <ixx>5.33333</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>21.6667</iyy>
            <iyz>0</iyz>
            <izz>21.6667</izz>
          </inertia>
          <mass>1</mass>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name='barrier_collision'>
          <geometry>
            <box>
              <size>8 0.5 5</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='barrier_visual'>
          <geometry>
            <box>
              <size>8 0.5 5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.9 0.3 0.3 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <static>true</static>
      <self_collide>false</self_collide>
    </model>

    <!-- Right barrier (8m width, positioned to leave 2m gap in center) -->
    <model name='barrier_right'>
      <pose>5 0 2.5 0 0 0</pose>
      <link name='barrier_link'>
        <inertial>
          <inertia>
            <ixx>5.33333</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>21.6667</iyy>
            <iyz>0</iyz>
            <izz>21.6667</izz>
          </inertia>
          <mass>1</mass>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name='barrier_collision'>
          <geometry>
            <box>
              <size>8 0.5 5</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='barrier_visual'>
          <geometry>
            <box>
              <size>8 0.5 5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.9 0.3 0.3 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <static>true</static>
      <self_collide>false</self_collide>
    </model>

    <!-- Light source -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

  </world>
</sdf>